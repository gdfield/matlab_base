function plot_polar_tuning(datarun, cell_spec, varargin)
%
% usage: plot_polar_tuning(datarun, cell_spec, varargin)
%
% This function plots the tuning curves in polar coordinates for grating responses to cells in
% the datarun structure indicated by cell_spec.
%
%   inputs
%       datarun     -   datarun structure
%       cell_spec   1   list of cell_ids or cell_type
%
%   optional inputs
%       color       k   color to plot in polar coordinates
%       cumulative_spikes   false   if true, plots cumulative spike number over trials, if false, plots spike rate
%       start_fig_num       1       figure to start plotting w/ if there are multiple spatial and/or temporal periods
%       normalize           true    normalize amplitude to max spike count
%                                   or spike number
%
%
% Created: GDF 2026-01-08
%

p = inputParser;
p.addParameter('color', 'k')
p.addParameter('cumulative_spikes', false, @islogical)
p.addParameter('start_fig_num', 1, @isnumeric)
p.addParameter('normalize', true, @islogical)
p.parse(varargin{:})


% check that stimulus field is there:
if isfield(datarun, 'stimulus')
    % extract spatial and temporal periods from datarun
    spatial_periods = datarun.stimulus.params.SPATIAL_PERIOD;
    temp_periods = datarun.stimulus.params.TEMPORAL_PERIOD;
    directions = datarun.stimulus.params.DIRECTION;
    num_sps = length(spatial_periods);
    num_tps = length(temp_periods);
    num_dirs = length(directions);
else
    error('datarun does not have a stimulus field; see load_stim function')
end

cell_indices = get_cell_indices(datarun, cell_spec);
num_rgcs = length(cell_indices);

spike_nums = zeros(num_rgcs, num_sps, num_tps, num_dirs+1);
spike_rates = zeros(num_rgcs, num_sps, num_tps, num_dirs+1);

normalize_flag = p.Results.normalize;

% loop over RGCs
for rgc = 1:num_rgcs
    temp_spike_times = datarun.spikes{cell_indices(rgc)};

    for spat_p = 1:num_sps
        for temp_p = 1:num_tps

            [~, temp_spike_nums, temp_spike_rates] = get_direction_tuning(temp_spike_times, datarun.stimulus,...
                                                            'SP', spatial_periods(spat_p), 'TP', temp_periods(temp_p));
            
            temp_spike_nums = [temp_spike_nums, temp_spike_nums(1)]; % this concatination is to 'close off' the polar plot
            temp_spike_rates = [temp_spike_rates, temp_spike_rates(1)];

            if normalize_flag
                temp_spike_nums = temp_spike_nums ./ max(temp_spike_nums);
                temp_spike_rates = temp_spike_rates ./ max(temp_spike_rates);
            end

            spike_nums(rgc, spat_p, temp_p, :) = temp_spike_nums;
            spike_rates(rgc, spat_p, temp_p, :) = temp_spike_rates;
        end
    end
end


test_var = squeeze(spike_rates(:,1,1,1:8));
[pcs, pc_weights, pc_vals, ~, var_exp] = pca(test_var);

plot(var_exp, 'ko')
scatter(pc_weights(:,1), pc_weights(:,3))
plot(pcs(:,5))


% this is to close the last segment of the polar plot
directions = [directions, directions(1)];

temp_fig_num = p.Results.start_fig_num;

for spat_p = 1:num_sps
    for temp_p = 1:num_tps
        figure(temp_fig_num); clf
        for rgc = 1:num_rgcs
            if p.Results.cumulative_spikes
                polarplot(deg2rad(directions), squeeze(spike_nums(rgc,spat_p, temp_p, :)), 'Color', p.Results.color);
                hold on
            else 
                polarplot(deg2rad(directions), squeeze(spike_rates(rgc,spat_p, temp_p, :)), 'Color', p.Results.color);
                hold on
            end
        end
        temp_fig_num = temp_fig_num + 1;
    end
end
